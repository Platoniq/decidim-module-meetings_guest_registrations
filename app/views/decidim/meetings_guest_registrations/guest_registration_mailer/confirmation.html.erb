<p class="email-greeting"><%= t("decidim.meetings_guest_registrations.mailer.greeting", name: @name) %></p>

<p class="email-instructions"><%= t("decidim.meetings_guest_registrations.mailer.#{@kind}.body_html", title: present(@meeting).title(html_escape: true), url: @locator.url) %></p>

<% if @registration_code_enabled %>
  <p><%= t("decidim.meetings_guest_registrations.mailer.registration_code", code: @registration.code) %></p>

  <center>
    <%= image_tag attachments[@qr_filename].url %>
  </center>
<% end %>

<% if @meeting.customize_registration_email? %>
  <p><%= present(@meeting).registration_email_custom_content %></p>
<% end %>

<p class="email-instructions"><%= t("decidim.meetings_guest_registrations.mailer.calendar_attached") %></p>

<%= render "decidim/meetings_guest_registrations/guest_registration_mailer/online_link" %>

<%= render "decidim/meetings_guest_registrations/guest_registration_mailer/cancel_link" %>
